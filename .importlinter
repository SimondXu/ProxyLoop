[importlinter]
root_packages =
    proxyloop
include_external_packages = True

[importlinter:contract:env-is-not-an-agent]
name = env never imports agent modules (ARCHITECTURE section 2)
type = forbidden
source_modules =
    proxyloop.env
forbidden_modules =
    proxyloop.kernel
    proxyloop.slow
    proxyloop.guard
    proxyloop.contract.views

[importlinter:contract:src-never-imports-tests]
name = nothing in proxyloop imports tests
type = forbidden
source_modules =
    proxyloop
forbidden_modules =
    tests

[importlinter:contract:agent-is-not-env]
name = guard never imports env (ARCHITECTURE section 2)
type = forbidden
source_modules =
    proxyloop.guard
forbidden_modules =
    proxyloop.env

[importlinter:contract:contract-is-self-contained]
name = contract imports only the stdlib and pydantic (ARCHITECTURE section 2)
type = forbidden
source_modules =
    proxyloop.contract
forbidden_modules =
    proxyloop.core
    proxyloop.kernel
    proxyloop.slow
    proxyloop.guard
    proxyloop.llm
    proxyloop.env
    proxyloop.evidence
    proxyloop.obs
    proxyloop.serve
    proxyloop.models
    proxyloop.training
    proxyloop.eval
    proxyloop.cli
    tests
    transformers
    jinja2
    hypothesis
    pytest
