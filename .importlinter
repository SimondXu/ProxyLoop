[importlinter]
root_packages =
    proxyloop
include_external_packages = True

[importlinter:contract:env-is-not-an-agent]
name = env never imports agent modules (ARCHITECTURE section 2)
type = forbidden
source_modules =
    proxyloop.env
forbidden_modules =
    proxyloop.kernel
    proxyloop.slow
    proxyloop.guard
    proxyloop.contract.views
    proxyloop.llm

[importlinter:contract:src-never-imports-tests]
name = nothing in proxyloop imports tests
type = forbidden
source_modules =
    proxyloop
forbidden_modules =
    tests

[importlinter:contract:agent-is-not-env]
name = guard never imports env (ARCHITECTURE section 2)
type = forbidden
source_modules =
    proxyloop.guard
forbidden_modules =
    proxyloop.env

[importlinter:contract:contract-is-self-contained]
name = contract imports only the stdlib and pydantic (ARCHITECTURE section 2)
type = forbidden
source_modules =
    proxyloop.contract
forbidden_modules =
    proxyloop.core
    proxyloop.kernel
    proxyloop.slow
    proxyloop.guard
    proxyloop.llm
    proxyloop.env
    proxyloop.evidence
    proxyloop.obs
    proxyloop.serve
    proxyloop.models
    proxyloop.training
    proxyloop.eval
    proxyloop.cli
    tests
    transformers
    jinja2
    hypothesis
    pytest

[importlinter:contract:fsm-is-not-world]
name = the FSM talker imports no world module (S1-MOD-01)
type = forbidden
source_modules =
    proxyloop.models.fsm
forbidden_modules =
    proxyloop.env

[importlinter:contract:serve-is-read-only]
name = serve is read-only (ARCHITECTURE section 2)
type = forbidden
source_modules =
    proxyloop.serve
forbidden_modules =
    proxyloop.contract.protocol
    proxyloop.core.bus
    proxyloop.core.log
    proxyloop.core.fold
    proxyloop.kernel
    proxyloop.llm
    proxyloop.slow
    proxyloop.env

[importlinter:contract:obs-reads-bundles-only]
name = obs reads bundles only (ADR-0008)
type = forbidden
source_modules =
    proxyloop.obs
forbidden_modules =
    proxyloop.kernel
    proxyloop.core.bus
    proxyloop.llm
    proxyloop.slow
    proxyloop.env
