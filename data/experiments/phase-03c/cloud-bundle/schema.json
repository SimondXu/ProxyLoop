{
  "$defs": {
    "CompletionClaim": {
      "additionalProperties": false,
      "properties": {
        "evidence_message_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Message Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "not_done",
            "candidate"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "evidence_message_ids"
      ],
      "title": "CompletionClaim",
      "type": "object"
    },
    "DialogueAct": {
      "enum": [
        "clarify",
        "counter",
        "confirm",
        "challenge",
        "escalate",
        "close"
      ],
      "title": "DialogueAct",
      "type": "string"
    },
    "FactUpdate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "source_message_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Message Id",
          "type": "string"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FactValue"
        }
      },
      "required": [
        "key",
        "value",
        "source_message_id",
        "confidence"
      ],
      "title": "FactUpdate",
      "type": "object"
    },
    "FactValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount_minor",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "ReasonerRequest": {
      "additionalProperties": false,
      "properties": {
        "needed": {
          "title": "Needed",
          "type": "boolean"
        },
        "reason_code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "needed",
        "reason_code"
      ],
      "title": "ReasonerRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Semantic fields a Fast model may propose without infrastructure IDs.",
  "properties": {
    "action_intent": {
      "title": "Action Intent",
      "type": "null"
    },
    "completion_claim": {
      "$ref": "#/$defs/CompletionClaim"
    },
    "dialogue_act": {
      "$ref": "#/$defs/DialogueAct"
    },
    "fact_updates": {
      "items": {
        "$ref": "#/$defs/FactUpdate"
      },
      "maxItems": 16,
      "title": "Fact Updates",
      "type": "array"
    },
    "reasoner_request": {
      "$ref": "#/$defs/ReasonerRequest"
    },
    "response_text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Response Text",
      "type": "string"
    }
  },
  "required": [
    "dialogue_act",
    "fact_updates",
    "reasoner_request",
    "completion_claim",
    "response_text",
    "action_intent"
  ],
  "title": "FastModelOutput",
  "type": "object"
}
