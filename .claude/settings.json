{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)"
    ],
    "deny": [
      "Bash(rm -rf data*)",
      "Bash(rm -rf ./data*)",
      "Bash(rm -rf external*)",
      "Bash(rm -rf ./external*)",
      "Bash(git clean *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_destructive.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_bash.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/owned_paths.py\""
          }
        ]
      }
    ]
  }
}
